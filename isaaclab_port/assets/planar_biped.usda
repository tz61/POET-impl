    def "joints"
    {
        def PhysicsFixedJoint "anchor_world_fixed"
        {
            rel physics:body1 = </planar_biped/anchor>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsPrismaticJoint "root_x"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </planar_biped/anchor>
            rel physics:body1 = </planar_biped/x_carriage>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -1000
            float physics:upperLimit = 1000
        }

