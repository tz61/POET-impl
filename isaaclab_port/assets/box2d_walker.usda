        }

        def Cube "collision_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </planar_biped/Materials/contact>
            bool physics:collisionEnabled = 1
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.26666668, 0.1, 1.1333333)
            double3 xformOp:translate = (0, 0, -0.5666666666666667)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
