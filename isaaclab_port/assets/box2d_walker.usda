#usda 1.0
(
    defaultPrim = "planar_biped"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "planar_biped" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    doc = "Local planar biped: passive x/z/pitch base and four hip/knee torque joints."
)
{
    def "Materials"
    {
        def Material "contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

    def Xform "anchor" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        bool physics:kinematicEnabled = 0
        float physics:mass = 1
        quatf physics:principalAxes = (1, 0, 0, 0)
        bool physics:rigidBodyEnabled = 1
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "x_carriage" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
