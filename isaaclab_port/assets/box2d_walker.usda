    def "joints"
    {
        def PhysicsFixedJoint "anchor_world_fixed"
        {
            rel physics:body1 = </planar_biped/anchor>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsPrismaticJoint "root_x"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </planar_biped/anchor>
            rel physics:body1 = </planar_biped/x_carriage>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -1000
            float physics:upperLimit = 1000
        }

        def PhysicsPrismaticJoint "root_z"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </planar_biped/x_carriage>
            rel physics:body1 = </planar_biped/z_carriage>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -1000
            float physics:upperLimit = 1000
        }

        def PhysicsRevoluteJoint "root_pitch"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </planar_biped/z_carriage>
            rel physics:body1 = </planar_biped/hull>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "left_hip" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 5.2359877
            float drive:angular:physics:maxForce = 80
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </planar_biped/hull>
            rel physics:body1 = </planar_biped/left_upper>
