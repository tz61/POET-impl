            double size = 1
            float3 xformOp:scale = (2.1333334, 0.2, 0.56666666)
            double3 xformOp:translate = (0.06666666666666665, 0, 0.016666666666666663)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "left_upper" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, -0.56666666)
        float3 physics:diagonalInertia = (0.03413992, 0.03413992, 0.03413992)
        bool physics:kinematicEnabled = 0
        float physics:mass = 0.30222222
